{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx", "lib": ["DOM", "ES2022"],
    "strict": true, "skipLibCheck": true, "resolveJsonModule": true, "esModuleInterop": true, "noEmit": true, "allowSyntheticDefaultImports": true,
    "noUnusedLocals": false, "types": ["node"]
  },
  "include": ["src"]
}
